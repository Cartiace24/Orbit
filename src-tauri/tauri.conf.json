{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBIT",
  "version": "0.1.0",
  "identifier": "com.orbit.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:49321",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ORBIT — PC Workbench",
        "width": 1180,
        "height": 780,
        "minWidth": 740,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#151918"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
